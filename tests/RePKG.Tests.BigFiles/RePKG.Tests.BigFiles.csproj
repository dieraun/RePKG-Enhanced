<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <RootNamespace>RePKG.Tests.BigFiles</RootNamespace>
        <!--
          大文件门禁测试默认不随 `dotnet test` 运行（每次要写 1–2 GiB 到磁盘、耗时数分钟）。
          设置环境变量 REPKG_BIG_TESTS=1 启用；或用可选的 REPKG_BIG_TMP 指定工作目录。
        -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\RePKG.Application\RePKG.Application.csproj" />
        <ProjectReference Include="..\RePKG.TestSupport\RePKG.TestSupport.csproj" />
    </ItemGroup>
</Project>
