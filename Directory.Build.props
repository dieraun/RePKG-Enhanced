<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <!-- 我们的新代码统一启用可空引用类型；上游原样保留的文件在各自 csproj 中关闭 -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 构建卫生：SkiaSharp / HarfBuzz / ANGLE 的原生包里，每个 RID 都带一份 .pdb（单份 80 MB 上下）。
       框架依赖构建会把整棵 runtimes\**\native 复制进每个工程的 bin，本机 7 个工程会放大约 2 GB。
       原生符号只对原生调试有用，托管调试用的是我们自己的 pdb，因此默认剔除；设 false 可恢复。 -->
  <PropertyGroup>
    <ExcludeNativeDebugSymbols Condition="'$(ExcludeNativeDebugSymbols)' == ''">true</ExcludeNativeDebugSymbols>
  </PropertyGroup>

  <!-- 版本号：与 git tag 对齐（v2.0.0 → 2.0.0）。
       NativeBootstrap 用 AssemblyInformationalVersion 命名原生库解压目录，改版本会换目录。 -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>RePKG-Enhanced</Product>
    <Authors>dieraun</Authors>
    <Company>RePKG-Enhanced</Company>
    <Copyright>MIT © 2026 dieraun · 基于 notscuffed/RePKG (MIT) 二次修改</Copyright>
    <RepositoryUrl>https://github.com/dieraun/RePKG-Enhanced</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
