<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>RePKG.Application</AssemblyName>
        <RootNamespace>RePKG.Application</RootNamespace>
        <Version>1.0.0</Version>
        <Copyright>基于 notscuffed/RePKG (MIT) 二次修改 — Copyright © NotScuffed 2025; modifications © RePKG-Enhanced contributors</Copyright>
        <!--
          阶段 1 的 D1：Application 由 netstandard2.0 上移到 net10.0。
          原因：流式内核与后续 GIF/量化实现需要 Span<byte>、BinaryPrimitives，
          以及 TEX 栈改用 SkiaSharp 后的 AOT/trim 注解。Core 仍保持 netstandard2.0。
          上游代码原样保留部分较多，暂不启用可空引用类型。
        -->
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RePKG.Core\RePKG.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="K4os.Compression.LZ4" />
        <!-- 过渡依赖：阶段 4 改为 SkiaSharp 后移除 -->
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="SixLabors.ImageSharp" />
    </ItemGroup>
</Project>
