<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RePKG.Gui.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="RePKG.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="RePKG-Enhanced — Wallpaper Engine pkg 提取"
        Width="1200" Height="780"
        MinWidth="880" MinHeight="560"
        DragDrop.AllowDrop="True">

  <Grid RowDefinitions="Auto,*,Auto" Margin="10">

    <!-- ───────── 工具栏：文件与筛选（无动画、无装饰，只有按钮） ───────── -->
    <Border Grid.Row="0" Padding="8" CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <WrapPanel Orientation="Horizontal">

        <Button Content="添加 pkg" Command="{CompiledBinding AddPackagesCommand}" Margin="0,0,6,4" />
        <Button Content="添加目录" Command="{CompiledBinding AddFolderCommand}" Margin="0,0,6,4" />
        <Button Content="移除选中" Command="{CompiledBinding RemovePackageCommand}" Margin="0,0,6,4" />
        <Button Content="清空" Command="{CompiledBinding ClearPackagesCommand}" Margin="0,0,16,4" />

        <TextBlock Text="筛选：" VerticalAlignment="Center" Margin="0,0,4,4" />
        <ComboBox ItemsSource="{CompiledBinding FilterOptions}"
                  SelectedItem="{CompiledBinding SelectedFilter}"
                  Width="120" Margin="0,0,16,4">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryKindFilter">
              <TextBlock Text="{CompiledBinding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Content="全选" Command="{CompiledBinding SelectAllCommand}" Margin="0,0,6,4" />
        <Button Content="全不选" Command="{CompiledBinding SelectNoneCommand}" Margin="0,0,6,4" />
        <Button Content="反选" Command="{CompiledBinding InvertSelectionCommand}" Margin="0,0,0,4" />
      </WrapPanel>
    </Border>

    <!-- ───────── 主体三栏 ───────── -->
    <Grid Grid.Row="1" ColumnDefinitions="300,4,*,4,380" Margin="0,10,0,10">

      <!-- 包列表 -->
      <Border Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              CornerRadius="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{CompiledBinding PackageCountText}"
                     Margin="10,8" FontWeight="SemiBold" />
          <ListBox ItemsSource="{CompiledBinding Packages}"
                   SelectedItem="{CompiledBinding SelectedPackage}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PackageViewModel">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                  <CheckBox Grid.Column="0" IsThreeState="True"
                            IsChecked="{CompiledBinding IsSelected, Mode=TwoWay}"
                            VerticalAlignment="Top" Margin="0,2,6,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{CompiledBinding DisplayName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{CompiledBinding FileName}" Opacity="0.7"
                               FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{CompiledBinding Summary}" Opacity="0.7" FontSize="11" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- 条目列表 -->
      <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              CornerRadius="6">
        <ListBox ItemsSource="{CompiledBinding VisibleEntries}"
                 SelectedItem="{CompiledBinding SelectedEntry}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EntryViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                <CheckBox Grid.Column="0" IsChecked="{CompiledBinding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                           Text="{CompiledBinding FullPath}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Opacity="0.65"
                           Margin="8,0,4,0" Text="{CompiledBinding LengthText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />

      <!-- 预览 -->
      <Border Grid.Column="4" BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="6" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="预览" FontWeight="SemiBold" Margin="0,0,0,6" />

          <Panel>
            <Image Source="{CompiledBinding PreviewImage}" Stretch="Uniform"
                   IsVisible="{CompiledBinding PreviewImage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <TextBox Text="{CompiledBinding PreviewText}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                     IsVisible="{CompiledBinding PreviewText, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{CompiledBinding PreviewNote}" TextWrapping="Wrap" Opacity="0.75"
                       IsVisible="{CompiledBinding PreviewNote, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          </Panel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ───────── 输出与状态栏 ───────── -->
    <Border Grid.Row="2" Padding="8" CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

        <!-- 输出目录 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="输出目录：" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{CompiledBinding OutputDirectory}" Margin="0,0,6,0" />
          <Button Grid.Column="2" Content="浏览…" Command="{CompiledBinding ChooseOutputCommand}" Margin="0,0,6,0" />
          <Button Grid.Column="3" Content="打开" Command="{CompiledBinding RevealOutputCommand}" />
        </Grid>

        <!-- 导出选项与动作 -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal">
          <CheckBox Content="递归子目录" IsChecked="{CompiledBinding Recursive}" Margin="0,0,12,4" />
          <CheckBox Content="覆盖已有文件" IsChecked="{CompiledBinding Overwrite}" Margin="0,0,12,4" />
          <CheckBox Content="TEX 转 PNG/GIF" IsChecked="{CompiledBinding ConvertTex}" Margin="0,0,12,4" />
          <CheckBox Content="写 .json 元信息" IsChecked="{CompiledBinding WriteTexInfo}" Margin="0,0,12,4" />
          <CheckBox Content="写 manifest 清单" IsChecked="{CompiledBinding WriteManifest}" Margin="0,0,16,4" />

          <TextBlock Text="并发" VerticalAlignment="Center" Margin="0,0,4,4" />
          <NumericUpDown Value="{CompiledBinding Concurrency}" Minimum="1" Maximum="4"
                         Increment="1" FormatString="0" Width="96" Margin="0,0,16,4" />

          <Button Content="开始导出" Command="{CompiledBinding ExportCommand}"
                  FontWeight="SemiBold" Margin="0,0,6,4" />
          <Button Content="暂停" Command="{CompiledBinding PauseCommand}" Margin="0,0,6,4" />
          <Button Content="继续" Command="{CompiledBinding ResumeCommand}" Margin="0,0,6,4" />
          <Button Content="取消" Command="{CompiledBinding CancelCommand}" Margin="0,0,0,4" />
        </WrapPanel>

        <!-- 进度与状态 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0">
            <ProgressBar Value="{CompiledBinding ProgressValue}" Minimum="0" Maximum="100" Height="6" />
            <TextBlock Text="{CompiledBinding ProgressText}" FontSize="11" Opacity="0.75" Margin="0,4,0,0" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{CompiledBinding StatusText}" FontSize="11"
                     VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="460" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
