<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RePKG.Gui.App"
             RequestedThemeVariant="Default">
  <!-- RequestedThemeVariant="Default" = 跟随系统明暗（阶段五功能规范） -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
