<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>RePKG-Enhanced</AssemblyName>
    <RootNamespace>RePKG.Gui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Windows x64 发布：NativeAOT + 三个原生库全部内嵌（单文件 .exe，目录里不留 DLL） -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <BundleNativeLibraries>true</BundleNativeLibraries>
    <BundledNativeLibraryNames>libSkiaSharp.dll;libHarfBuzzSharp.dll;av_libglesv2.dll</BundledNativeLibraryNames>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RePKG.Shared\RePKG.Shared.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\NativeBundle.targets" />

</Project>
